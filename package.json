{
  "name": "spiderpanel-cf",
  "version": "1.0.0",
  "private": true,
  "description": "SpiderPanel Cloudflare Workers edition - deploy straight from GitHub",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types",
    "build": "node scripts/provision-kv.mjs && esbuild src/worker.js --bundle --format=esm --platform=neutral --external:cloudflare:sockets --outfile=/tmp/spider-bundle.mjs",
    "test": "npm run build && node scripts/spider-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.14.1"
  }
}
